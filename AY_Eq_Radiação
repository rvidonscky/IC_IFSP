# RADIAÇÃO DIRETA ---------------------------------------------------------------------------------------------------------------------

import math
import matplotlib.pyplot as plt

# conversões úteis:
def deg2rad(x):
    return x * math.pi / 180.0

def rad2deg(x):
    return x * 180.0 / math.pi

# declinação solar, em radianos, depende do dia do ano n
# δ = 23.45° * sin( 360° * (284 + n) / 365 )
def SolarDeclination(day_of_year):
    deg = 23.45 * math.sin(deg2rad(360.0 * (284 + day_of_year) / 365.0))
    return deg2rad(deg)

# ângulo horário - definido no texto abaixo da eq 2 -
# H_r = (hora_local - 12) * 15°  (15° por hora)
def hour_angle(hora_decimal):
    return deg2rad((hora_decimal - 12.0) * 15.0)

# seno do ângulo de altitude solar, beta, da eq 2
# sin(b) =  cos(i)*cos(δ)*cos(H_r) + sin(i)*sin(δ)
def sin_solar_altitude(latitude_deg, decl_rad, hour_ang_rad):
    i = deg2rad(latitude_deg)
    return math.cos(i) * math.cos(hour_ang_rad) * math.cos(decl_rad) + math.sin(i) * math.sin(decl_rad)

# radiação direta
# Idn = Ic * exp( - B / sin(b) )
def direct_radiation(Ic, B, sinb):
    if sinb <= 0.0:
        return 0.0
    return Ic * math.exp(-B / sinb)

# RADIAÇÃO DIFUSA ---------------------------------------------------------------------------------------------------------------------

# da eq 5:FSS = (1 + cos(S)) / 2
def FSS(tilt_deg):
    S = deg2rad(tilt_deg)
    return (1.0 + math.cos(S)) / 2.0

# eq 4: Idq = C * IDN * FSS
def diffuse_radiation(IDN, tilt_deg):
    C = 0.135
    fss = FSS(tilt_deg)
    Idq = C * IDN * fss
    return Idq

# RADIAÇÃO REFLETIDA ----------------------------------------------------------------------------------------------------------------

# da eq 7: Fsg = (1 - cos(S)) / 2
def Fsg(tilt_deg):
    S = deg2rad(tilt_deg)
    return (1.0 - math.cos(S)) / 2.0

# eq 6: Irq = (IDN + Idq) * krq * Fsg
def reflected_radiation(IDN, Idq, tilt_deg):
    krq = 0.2
    fsg = Fsg(tilt_deg)
    Irq = (IDN + Idq) * krq * fsg
    return Irq

# RADIAÇÃO TOTAL ----------------------------------------------------------------------------------------------------------------------
# pega o cosseno pela relação lá cos² + sen² = 1
def cos_from_sin(sin_val):
    return math.sqrt(max(0.0, 1.0 - sin_val * sin_val))

# eq 10 na forma expandida: cos(f) = (sin(b) - sin(i)*sin(δ)) / (cos(i)*cos(δ)) 
def cos_solar_azimuth(latitude_deg, decl_rad, sinb):
    i = deg2rad(latitude_deg)
    numerador = (sinb - math.sin(i) * math.sin(decl_rad))
    denominador = math.cos(i) * math.cos(decl_rad)
    if abs(denominador) < 1e-8:
        return 1.0
    cosf = numerador / denominador
    return max(-1.0, min(1.0, cosf))  # evita erro numérico

# eq 9 expandida:
# cos(q) = sin(δ)*sin(i)*cos(S)
#         - sin(δ)*cos(i)*sin(S)*cos(f)
#         + cos(δ)*cos(i)*cos(S)*cos(Hr)
#         + cos(δ)*sin(i)*sin(S)*cos(f)*cos(Hr)
#         + cos(δ)*sin(S)*sin(f)*sin(Hr)
def cos_incidence_full(latitude_deg, decl_rad, tilt_deg, hour_ang_rad, cosf):
    i = deg2rad(latitude_deg)
    S = deg2rad(tilt_deg)
    sinf = math.sqrt(max(0.0, 1.0 - cosf**2))
    term1 = math.sin(decl_rad) * math.sin(i) * math.cos(S)
    term2 = -math.sin(decl_rad) * math.cos(i) * math.sin(S) * cosf
    term3 = math.cos(decl_rad) * math.cos(i) * math.cos(S) * math.cos(hour_ang_rad)
    term4 = math.cos(decl_rad) * math.sin(i) * math.sin(S) * cosf * math.cos(hour_ang_rad)
    term5 = math.cos(decl_rad) * math.sin(S) * sinf * math.sin(hour_ang_rad)
    cosq = term1 + term2 + term3 + term4 + term5
    return cosq

# eq 8: It = Idn * cos(q) + Idq + Irq
def total_radiation(IDN, Idq, Irq, cosq):
    if cosq < 0:
        cosq = 0.0  # sol atrás da superfície
    It = IDN * cosq + Idq + Irq
    return It

# ----------------------------------------------------------------------------------------------
# valores do artigo (caso de verão, agosto no local do artigo)
Ic = 1357          # constante solar 
latitude_deg = 32  # latitude do local 
tilt_deg = 37      # inclinação do coletor
B = 0.21           # coeficiente atmosférico de verão
day_of_year = 200  # agosto (verão)
# ----------------------------------------------------------------------------------------------
# cálculos hora a hora
horas = [h/4 for h in range(6*4, 19*4+1)]  # 6.00, 6.25, 6.50, ..., 19.00
It_values = []
decl_rad = SolarDeclination(day_of_year)

for hora in horas:
    Hr = hour_angle(hora)
    sinb = sin_solar_altitude(latitude_deg, decl_rad, Hr)
    if sinb <= 0:
        It_values.append(0.0)
        continue
    IDN = direct_radiation(Ic, B, sinb)
    Idq = diffuse_radiation(IDN, tilt_deg)
    Irq = reflected_radiation(IDN, Idq, tilt_deg)
    cosf = cos_solar_azimuth(latitude_deg, decl_rad, sinb)
    cosq = cos_incidence_full(latitude_deg, decl_rad, tilt_deg, Hr, cosf)
    It = total_radiation(IDN, Idq, Irq, cosq)
    It_values.append(It)

# ----------------------------------------------------------------------------------------------
# plot
plt.figure(figsize=(8,5))
plt.plot(horas, It_values, color='blue')
plt.title("Radiação Solar por Hora")
plt.xlabel("Hora do dia")
plt.ylabel("Radiação total (W/m²)")
plt.grid(True)
plt.tight_layout()
plt.show()


