class Interior(SubDomain):
    name = 'interior'
    def define(self, dimensions):
        x, z = dimensions
        return {x: x, z: ('middle', 1, 1)}

class Fundo(SubDomain):
    name = 'fundo'
    def define(self, dimensions):
        x, z = dimensions
        return {x: x, z: ('right', 1)}

class Topo(SubDomain):
    name = 'topo'
    def define(self, dimensions):
        x, z = dimensions
        return {x: x, z: ('right', 1)} # 'left' indica o início de z, espessura de 1 nó


class Meio(SubDomain):
    name = 'meio'
    def define(self, dimensions):
        x, z = dimensions
        # ('middle', 1, 1) significa: pegue o meio, pulando 1 nó no começo e 1 nó no final
        return {x: x, z: z} # ('middle', 1, 1)}

